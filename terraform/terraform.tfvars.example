aws_region  = "us-west-2"
project     = "api-demo"
environment = "poc"

# RDS
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20

# ECS - scale up for production
api_cpu           = 256
api_memory        = 512
api_desired_count = 1
airflow_cpu       = 512
airflow_memory    = 1024
superset_cpu      = 512
superset_memory   = 1024
